    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Create Train-Valid Dataset",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/phase1/start.py",
            "console": "integratedTerminal",
            "args": [
                "-noh",
                "4",
                "10",
                "19",
                "28",
                "52",
                "55",
                "58",
                "79",
                "100",
                "112",
                "-i",
                "E:/Work Spaces/Thesis/Data/SiCH_v2/input",
                "-o",
                "E:/Work Spaces/Thesis/Data/SiCH_v2/output",
                "-p",
                "E:/Work Spaces/Thesis/Data/SiCH_v2/predict_112",
                "-logdir",
                "E:/Work Spaces/Thesis/Data/SiCH_v2/logs",
                "-omd",
                "-v"
            ]
        },
        {
            "name": "Python Debugger: Create Predict Dataset (version 2)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/phase1/start.py",
            "console": "integratedTerminal",
            "args": [
                "-i",
                "E:/Work Spaces/Thesis/Data/SiCH_v2/input",
                "-o",
                "E:/Work Spaces/Thesis/Data/SiCH_v2/output", // bypass check output folder, not important name of folder, but path must exist
                "-omd",
                "-v"
            ]
        },
        {
            "name": "Python Debugger: Create Predict Dataset (version 1)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/phase1/start.py",
            "console": "integratedTerminal",
            "args": [
                "-i",
                "E:/Work Spaces/Thesis/Data/SiCH_v2/input",
                "-o",
                "E:/Work Spaces/Thesis/Data/SiCH_v2/output",
                "-noh",
                "4",
                "10",
                // "19",
                // "28",
                "52",
                "55",
                "58",
                // "79",
                "100",
                "112",
                "-omd",
                "-v"
            ]
        },
        {
            "name": "Python Debugger: Run Test Predict",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/phase1/start.py",
            "console": "integratedTerminal",
            "args": [
                "-pred_only",
                "-mp", "E:/Work Spaces/Thesis/Data/model/52_55_58_100_112_graph_non_data_under_52H.pb",
                "-p", "E:/Work Spaces/Thesis/Data/SiCH_v2/predict_79",
                "-tf",
                "-v"
            ]
        }
    ]
